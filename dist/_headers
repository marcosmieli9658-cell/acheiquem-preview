/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/styles.css
  Cache-Control: no-cache

/app.css
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/home.js
  Cache-Control: no-cache

/data.js
  Cache-Control: no-cache

/icons.js
  Cache-Control: no-cache

/seo.js
  Cache-Control: no-cache

/admin
  Cache-Control: no-store

/admin/*
  Cache-Control: no-store
